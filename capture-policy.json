{
  "files": [
    ".profile", ".bash_profile", ".bashrc", ".bash_logout",
    ".zshenv", ".zprofile", ".zshrc", ".zsh_logout",
    ".gitconfig", ".gitignore_global", ".inputrc", ".nanorc",
    ".vimrc", ".tmux.conf", ".editorconfig",
    ".config/.shell_*", ".config/starship.toml",
    ".config/micro/settings.json", ".config/micro/bindings.json",
    ".config/fish/config.fish", ".config/kitty/kitty.conf",
    ".config/htop/htoprc", ".config/btop/btop.conf",
    ".config/powershell/Microsoft.PowerShell_profile.ps1"
  ],
  "directories": [".config/nvim", ".config/utils"],
  "max_file_bytes": 1048576,
  "excludes": [".DS_Store", "*/.DS_Store", "*.bak", "*.swp", "*.swo"],
  "exclude_components": [
    ".ssh", ".aws", ".gnupg", ".codex", ".agents", ".claude", "node_modules",
    ".env", ".env.*", "*.pem", "*.key", "*private*", "*secret*", "*token*",
    "*credentials*", "*auth*", "*history*", "*cache*", "*session*", "*buffers*",
    "*backup*", "*.local", "*.local.*"
  ]
}
