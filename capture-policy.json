{
  "patterns": [
    ".bash_logout",
    ".bash_profile", 
    ".bashrc", 
    ".config/.shell_*", 
    ".config/btop/btop.conf",
    ".config/htop",
    ".config/kitty",
    ".config/micro/*.json",
    ".config/nano",
    ".config/neofetch", 
    ".config/NuGet", 
    ".config/nvim", 
    ".config/powershell",
    ".config/starship.toml",
    ".config/thefuck",
    ".config/utils",
    ".editorconfig",
    ".nanorc",
    ".profile", 
    ".tmux.conf", 
    ".tmux", 
    ".vim",
    ".vimrc", 
    ".zprofile", 
    ".zsh_logout",
    ".zshenv", 
    ".zshrc"
  ],
  "max_file_bytes": 1048576,
  "excludes": [".DS_Store", "*/.DS_Store", "*.bak", "*.swp", "*.swo"],
  "exclude_components": [
    ".ssh", ".aws", ".gnupg", ".codex", ".agents", ".claude", "node_modules",
    ".env", ".env.*", "*.pem", "*.key", "*private*", "*secret*", "*token*",
    "*credentials*", "*auth*", "*history*", "*cache*", "*session*", "*buffers*",
    "*backup*", "*.local", "*.local.*"
  ]
}
