# cannibalizing from:
# https://github.com/paulirish/dotfiles/blob/master/.aliases

# Easier navigation: .., ..., ~ and -
alias ~='cd ~' # `cd` is probably faster to type though
alias cd..='cd ..'
alias cd~='cd ~'

## cp, mv, rm
alias cp='cp -v'
alias mv='mv -v'
alias rm='rm -i'
#alias rm='rm -rf -i'

# MISC

# exa is sometimes problematic, so use ls as a fallback
ls () {
    eza_opts=(-labhH --icons --time-style 'long-iso')
    [[ "$#" -ne 0 ]] && command ls "$@" || command eza "${eza_opts[@]}"
}

